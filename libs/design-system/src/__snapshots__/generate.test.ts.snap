// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generated CSS > base.css is shadow-root aware and disables motion under prefers-reduced-motion 1`] = `
"/* GENERATED by \`nx run design-system:generate\` from src/tokens.ts. Do not edit. */
@layer base {
  :host,
  html {
    font-family: var(--font-sans);
    color: var(--bf-ink);
    background-color: var(--bf-surface);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  a {
    color: var(--bf-accent);
    text-underline-offset: 0.2em;
  }

  :focus-visible {
    outline: 3px solid var(--bf-focus);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  ::selection {
    background-color: color-mix(in oklab, var(--bf-accent) 35%, transparent);
  }

  [hidden] {
    display: none !important;
  }
}

/* Reduced motion: no transitions, no animations, no smooth scrolling. */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    transition-duration: 0ms !important;
    scroll-behavior: auto !important;
  }
}
"
`;

exports[`generated CSS > modes.css defines light and dark values keyed off data-theme, with a system fallback 1`] = `
"/* GENERATED by \`nx run design-system:generate\` from src/tokens.ts. Do not edit. */
:root,
:root[data-theme='light'] {
  color-scheme: light;
  --bf-surface: #f7f7fb;
  --bf-surface-raised: #ffffff;
  --bf-surface-sunken: #ecedf5;
  --bf-ink: #0f1222;
  --bf-ink-muted: #4a5070;
  --bf-accent: #5b3df5;
  --bf-accent-ink: #ffffff;
  --bf-accent-2: #0e7490;
  --bf-border: #d5d8e8;
  --bf-focus: #b45309;
  --bf-success: #047857;
  --bf-danger: #b91c1c;
  --bf-duration-instant: 0ms;
  --bf-duration-fast: 150ms;
  --bf-duration-base: 250ms;
  --bf-duration-slow: 450ms;
  --bf-duration-dramatic: 800ms;
}

:root[data-theme='dark'] {
  color-scheme: dark;
  --bf-surface: #0b0d17;
  --bf-surface-raised: #151a2e;
  --bf-surface-sunken: #070910;
  --bf-ink: #f3f4ff;
  --bf-ink-muted: #a9b0d6;
  --bf-accent: #8b7cff;
  --bf-accent-ink: #0b0d17;
  --bf-accent-2: #22d3ee;
  --bf-border: #2a3152;
  --bf-focus: #facc15;
  --bf-success: #34d399;
  --bf-danger: #f87171;
}

/* No stored choice and no script yet: follow the system. */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) {
    color-scheme: dark;
    --bf-surface: #0b0d17;
    --bf-surface-raised: #151a2e;
    --bf-surface-sunken: #070910;
    --bf-ink: #f3f4ff;
    --bf-ink-muted: #a9b0d6;
    --bf-accent: #8b7cff;
    --bf-accent-ink: #0b0d17;
    --bf-accent-2: #22d3ee;
    --bf-border: #2a3152;
    --bf-focus: #facc15;
    --bf-success: #34d399;
    --bf-danger: #f87171;
  }
}

@media (prefers-reduced-motion: reduce) {
  :root {
    --bf-duration-instant: 0ms;
    --bf-duration-fast: 0ms;
    --bf-duration-base: 0ms;
    --bf-duration-slow: 0ms;
    --bf-duration-dramatic: 0ms;
  }
}
"
`;

exports[`generated CSS > theme.css maps every color utility to a semantic variable and drops the default palette 1`] = `
"/* GENERATED by \`nx run design-system:generate\` from src/tokens.ts. Do not edit. */
@theme inline {
  --color-*: initial;
  --color-transparent: transparent;
  --color-current: currentColor;
  --color-white: #ffffff;
  --color-black: #000000;
  --color-surface: var(--bf-surface);
  --color-surface-raised: var(--bf-surface-raised);
  --color-surface-sunken: var(--bf-surface-sunken);
  --color-ink: var(--bf-ink);
  --color-ink-muted: var(--bf-ink-muted);
  --color-accent: var(--bf-accent);
  --color-accent-ink: var(--bf-accent-ink);
  --color-accent-2: var(--bf-accent-2);
  --color-border: var(--bf-border);
  --color-focus: var(--bf-focus);
  --color-success: var(--bf-success);
  --color-danger: var(--bf-danger);
}

@theme {
  --font-display: 'Space Grotesk Variable', 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
  --font-sans: 'Inter Variable', 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  --spacing: 0.25rem;
  --text-xs: 0.75rem;
  --text-xs--line-height: 1rem;
  --text-sm: 0.875rem;
  --text-sm--line-height: 1.25rem;
  --text-base: 1rem;
  --text-base--line-height: 1.6rem;
  --text-lg: 1.125rem;
  --text-lg--line-height: 1.75rem;
  --text-xl: 1.375rem;
  --text-xl--line-height: 1.9rem;
  --text-2xl: clamp(1.6rem, 1.2rem + 1.5vw, 2rem);
  --text-2xl--line-height: 1.2;
  --text-3xl: clamp(2rem, 1.4rem + 2.5vw, 3rem);
  --text-3xl--line-height: 1.1;
  --text-4xl: clamp(2.5rem, 1.5rem + 4.5vw, 4.5rem);
  --text-4xl--line-height: 1.02;
  --text-5xl: clamp(3rem, 1.5rem + 7vw, 7rem);
  --text-5xl--line-height: 0.95;
  --radius-*: initial;
  --radius-sm: 0.375rem;
  --radius-md: 0.75rem;
  --radius-lg: 1.25rem;
  --radius-xl: 2rem;
  --radius-pill: 999px;
  --shadow-*: initial;
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.25);
  --shadow-md: 0 6px 20px -6px rgb(0 0 0 / 0.35);
  --shadow-lg: 0 18px 50px -12px rgb(0 0 0 / 0.45);
  --shadow-glow: 0 0 0 1px color-mix(in oklab, var(--bf-accent) 40%, transparent), 0 10px 40px -10px color-mix(in oklab, var(--bf-accent) 60%, transparent);
  --breakpoint-*: initial;
  --breakpoint-sm: 40rem;
  --breakpoint-md: 48rem;
  --breakpoint-lg: 64rem;
  --breakpoint-xl: 80rem;
  --ease-*: initial;
  --ease-standard: cubic-bezier(0.2, 0, 0, 1);
  --ease-emphasized: cubic-bezier(0.3, 0, 0, 1.3);
  --ease-exit: cubic-bezier(0.4, 0, 1, 1);
  --animate-*: initial;
  --animate-rise: bf-rise 450ms cubic-bezier(0.3, 0, 0, 1.3) both;
  --animate-fade: bf-fade 250ms cubic-bezier(0.2, 0, 0, 1) both;
  --animate-pulse: bf-pulse 1600ms cubic-bezier(0.2, 0, 0, 1) infinite;

  @keyframes bf-rise {
    from { opacity: 0; transform: translateY(1.25rem); } to { opacity: 1; transform: none; }
  }

  @keyframes bf-fade {
    from { opacity: 0; } to { opacity: 1; }
  }

  @keyframes bf-pulse {
    0%, 100% { opacity: 1; } 50% { opacity: 0.55; }
  }
}
"
`;
