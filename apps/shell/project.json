{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "shell",
  "projectType": "application",
  "sourceRoot": "apps/shell/src",
  "tags": [
    "type:app",
    "scope:shell"
  ],
  "targets": {
    "build": {
      "command": "rspack build -c rspack.config.mjs --mode production",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/shell"
      ]
    },
    "serve": {
      "command": "rspack serve -c rspack.config.mjs --mode development",
      "options": {
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json --noEmit",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "command": "vitest run",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
