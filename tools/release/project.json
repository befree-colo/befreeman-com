{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "release",
  "projectType": "library",
  "sourceRoot": "tools/release/src",
  "tags": [
    "type:tool"
  ],
  "targets": {
    "release": {
      "command": "tsx src/cli.ts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "command": "vitest run",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json --noEmit",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
